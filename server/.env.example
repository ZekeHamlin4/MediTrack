# Copy this file to server/.env and fill in what you want to use. Never commit .env.

# AI assistant (get a key at https://platform.claude.com)
ANTHROPIC_API_KEY=
# ASSISTANT_WEB_SEARCH=off   # uncomment to stop the assistant from searching the web

# Sending email (Gmail example: use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Reading email
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
